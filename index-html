<script>
(function(){
  var gal=document.getElementById('gallery'),lb=document.getElementById('lb'),lbi=document.getElementById('lb-img');
  if(gal&&lb&&lbi){
    gal.addEventListener('click',function(e){
      var t=e.target;
      if(t&&t.tagName==='IMG'){lbi.src=t.src;lbi.alt=t.alt;lb.hidden=false;}
    });
    lb.addEventListener('click',function(){lb.hidden=true;lbi.src='';});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){lb.hidden=true;}});
  }
  var BASE='https://wa.me/22383857260?text=';
  var links=document.querySelectorAll('a.wa');
  for(var i=0;i<links.length;i++){
    var m=links[i].getAttribute('data-msg');
    if(m){links[i].href=BASE+encodeURIComponent(m);}
  }
  var f={s:document.getElementById('service'),n:document.getElementById('nom'),v:document.getElementById('ville'),d:document.getElementById('details'),a:document.getElementById('send')};
  function build(){
    var parts=['Bonjour La Maison Dembélé,'];
    var who=f.n.value.trim();
    var where=f.v.value.trim();
    if(who){parts.push('je suis '+who+(where?' ('+where+')':'')+'.');}
    else if(where){parts.push('je vous écris de '+where+'.');}
    parts.push('Service : '+f.s.value+'.');
    var det=f.d.value.trim();
    if(det){parts.push('Mon besoin : '+det);}
    f.a.href=BASE+encodeURIComponent(parts.join(' '));
  }
  [f.s,f.n,f.v,f.d].forEach(function(el){el.addEventListener('input',build);el.addEventListener('change',build);});
  document.getElementById('devis-form').addEventListener('submit',function(e){e.preventDefault();});
  build();
  var copies=document.querySelectorAll('.copy');
  Array.prototype.forEach.call(copies,function(btn){
    btn.addEventListener('click',function(){
      var txt=btn.getAttribute('data-copy');
      var label=btn.textContent;
      function done(ok){btn.textContent=ok?'Numéro copié':'Sélectionnez le numéro ci-dessus';setTimeout(function(){btn.textContent=label;},2200);}
      var num=btn.parentNode.querySelector('.num');
      function fallback(){
        try{var r=document.createRange();r.selectNodeContents(num);var s=window.getSelection();s.removeAllRanges();s.addRange(r);done(false);}catch(err){done(false);}
      }
      try{
        navigator.clipboard.writeText(txt).then(function(){done(true);},fallback);
      }catch(err){fallback();}
    });
  });
  var y=document.getElementById('yr');
  if(y){y.textContent=new Date().getFullYear();}
})();
</script>

